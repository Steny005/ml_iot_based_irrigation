# Optional: External LLM API Key (Google Gemini / OpenAI compatible)
# If left empty, system operates 100% reliably using verified KAU/ICAR agronomic rule engines.
GEMINI_API_KEY=

# Administrative Authorization Key for POST /api/feed/refresh
ADMIN_SECRET_KEY=admin_secure_irrigation_2026

# Farm Geolocation (Default: Central Kerala Agro-Climatic Zone)
FARM_LATITUDE=9.50996
FARM_LONGITUDE=76.55067

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
